+"""Collect the whole test tree and execute the registered core groups; report both counts honestly."""
+import argparse
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+from .provenance import write_json
+
+CORE_GROUPS = ['tests/cutfem_preproduction', 'tests/cutfem_assembly', 'tests/cutfem_solver', 'tests/cutfem_runtime',
+               'tests/cutfem_gp', 'tests/cutfem_reference', 'tests/cutfem_multiconstraint', 'tests/cutfem_accuracy',
+               'tests/cutfem_q2', 'tests/cutfem_precondition', 'tests/cutfem_full_interface', 'tests/interface_energy',
+               'tests/q1_true_implicit_ghost', 'tests/teacher_accuracy', 'tests/implicit_convergence',
+               'tests/implicit_macro_cut_whole_boundary', 'tests/implicit_quadrature']
+
+
+def pytest(arguments):
+    process = subprocess.run([sys.executable, '-m', 'pytest', *arguments, '-q', '-p', 'no:cacheprovider'],
+                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    return process.returncode, process.stdout
+
+
+def summary_line(output):
+    return next((line for line in reversed(output.strip().splitlines()) if 'passed' in line or 'failed' in line or 'error' in line), '')
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--groups', nargs='*', default=CORE_GROUPS)
+    parser.add_argument('--skip-collection', action='store_true')
+    args = parser.parse_args()
+    out = Path(os.environ['CUTFEM_STAGE_OUTPUT'])
+    start = time.perf_counter()
+    collected = None
+    if not args.skip_collection:
+        code, output = pytest(['tests', '--collect-only'])
+        (out/'collection.log').write_text(output)
+        line = summary_line(output)
+        collected = dict(returncode=code, summary=line)
+    code, output = pytest(args.groups)
+    (out/'execution.log').write_text(output)
+    line = summary_line(output)
+    import re
+    passed = int(m.group(1)) if (m := re.search(r'(\d+) passed', line)) else 0
+    failed = int(m.group(1)) if (m := re.search(r'(\d+) failed', line)) else 0
+    result = dict(status='CORE_GROUPS_EXECUTED' if code == 0 else 'CORE_GROUPS_FAILED', collection=collected,
+                  executed_groups=args.groups, executed_passed=passed, executed_failed=failed, execution_summary=line,
+                  note='Collected count covers the historical tree; only executed_passed tests were actually run',
+                  seconds=time.perf_counter()-start)
+    write_json(out/'RESULT.json', result)
+    print(json.dumps(result), flush=True)
+    if code != 0:
+        raise SystemExit(1)
+
+
+if __name__ == '__main__':
+    main()
