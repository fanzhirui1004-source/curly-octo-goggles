+import numpy as np
+from stage_cutfem_preproduction.packet_pair import evaluate_pair_gates, pair_gate_policy
+
+
+def test_policy_is_registered_and_strict_is_tighter():
+    policy, digest = pair_gate_policy()
+    assert len(digest) == 64
+    for key in ('trace_relative', 'reaction_relative', 'energy_relative'):
+        assert policy['strict'][key] < policy['production'][key] <= 1e-6
+
+
+def test_strict_pass_keeps_historical_status():
+    g = evaluate_pair_gates([1e-11, 2e-11], [1e-10, 3e-10], [1e-10, 5e-10], True)
+    assert g['status'] == 'SAVED_N32_PACKET_PAIR_REPLAY_PASS' and g['strict_gate_passed'] and g['production_gate_passed']
+
+
+def test_measured_t04_deviations_pass_production_gate_only():
+    # R21_T04_P00: reaction 4.6e-8, energy 2.4e-7, trace 2.1e-8 stopped the strict gate.
+    g = evaluate_pair_gates([9.5e-9, 2.1e-8], [2.1e-9, 4.6e-8], [3.5e-10, 2.4e-7], True)
+    assert g['status'] == 'SAVED_N32_PACKET_PAIR_REPLAY_PASS_PRODUCTION_GATE'
+    assert not g['strict_gate_passed'] and g['production_gate_passed']
+
+
+def test_large_deviation_or_nonconvergence_still_stops():
+    assert evaluate_pair_gates([1e-3], [1e-3], [1e-3], True)['status'] == 'SAVED_PACKET_PAIR_VS_BODY_STOP'
+    assert evaluate_pair_gates([1e-12], [1e-12], [1e-12], False)['status'] == 'SAVED_PACKET_PAIR_VS_BODY_STOP'
+    assert evaluate_pair_gates([np.nan], [1e-12], [1e-12], True)['status'] == 'SAVED_PACKET_PAIR_VS_BODY_STOP'
