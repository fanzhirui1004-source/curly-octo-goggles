@@ -0,0 +1,62 @@
+"""Per-cell quadrature throughput versus worker count; run only on an idle box.
+
+Usage (inside the runner, stage tests):
+    python -m stage_cutfem_runtime.scaling_probe --geometry-run <sealed geometry run> --workers 1 16 32 64
+"""
+import argparse
+import json
+import os
+import statistics
+import time
+from pathlib import Path
+import numpy as np
+
+
+def job(args):
+    from stage_cutfem_multiconstraint.quadrature import qualify
+    from stage_cutfem_gp.shift_body import factors
+    contract, index = args
+    idx = np.array(index)
+    t0 = time.perf_counter()
+    rule = qualify(contract, idx/contract.n, (idx+1)/contract.n)
+    t1 = time.perf_counter()
+    factors(contract, idx, rule)
+    return dict(qualify=t1-t0, factors=time.perf_counter()-t1, points=len(rule.weights), pid=os.getpid())
+
+
+def main():
+    from stage_cutfem_multiconstraint.topology import Contract
+    from stage_cutfem_runtime.parallel import ExecutionPool
+    from stage_cutfem_runtime.provenance import write_json
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--geometry-run', required=True)
+    parser.add_argument('--workers', nargs='+', type=int, default=[1, 16, 32, 64])
+    parser.add_argument('--cells-per-worker', type=int, default=6)
+    parser.add_argument('--seed', type=int, default=1)
+    args = parser.parse_args()
+    out = Path(os.environ['CUTFEM_STAGE_OUTPUT'])
+    t = json.loads((Path(args.geometry_run)/'TOPOLOGY.json').read_text())
+    ct = t['contract']
+    from fractions import Fraction as F
+    c = Contract(ct['case_id'], int(ct['n']), tuple(float(F(x)) for x in ct['normal']), float(F(ct['offset'])))
+    cells = t['active_parent_cells']
+    rng = np.random.default_rng(args.seed)
+    rows = []
+    for workers in args.workers:
+        n = max(24, workers*args.cells_per_worker)
+        pick = [cells[i] for i in rng.choice(len(cells), n, replace=False)]
+        t0 = time.perf_counter()
+        with ExecutionPool(workers) as pool:
+            results = [r for _, r in pool.map_unordered(job, [(c, p) for p in pick])]
+        wall = time.perf_counter()-t0
+        cut = [r['qualify'] for r in results if r['points'] > 27]
+        rows.append(dict(workers=workers, cells=n, wall=round(wall, 2), cells_per_second=round(n/wall, 3),
+                         mean_qualify=round(statistics.mean(r['qualify'] for r in results), 4),
+                         cut_mean_qualify=round(statistics.mean(cut), 4) if cut else None, cut_cells=len(cut),
+                         distinct_pids=len({r['pid'] for r in results})))
+        print(json.dumps(rows[-1]), flush=True)
+    write_json(out/'RESULT.json', dict(status='SCALING_PROBE_RECORDED', rows=rows, geometry_run=args.geometry_run))
+
+
+if __name__ == '__main__':
+    main()
