@@ -0,0 +1,26 @@
+import json
+from pathlib import Path
+from stage_cutfem_runtime.parallel import ExecutionPool
+from stage_cutfem_preproduction.pipeline import plan_case, policy
+
+
+def _square(x):
+    return x*x
+
+
+def test_map_unordered_covers_every_job_with_indices():
+    with ExecutionPool(2) as pool:
+        results = dict(pool.map_unordered(_square, list(range(37))))
+    assert results == {i: i*i for i in range(37)}
+    with ExecutionPool(1) as pool:
+        assert dict(pool.map_unordered(_square, [3, 4])) == {0: 9, 1: 16}
+
+
+def test_pipeline_policy_and_audit_plan():
+    rules = policy()
+    assert rules['lanes'] == 2 and rules['pair_audit_every'] >= 1
+    assert sum(rules['stage_pss_gib'][k] for k in ('geometry', 'operator')) <= rules['memory_budget_gib'] <= rules['container_guard_gib']
+    plans = [plan_case('PROD', f'pop_cut_{i:04d}', (i % rules['pair_audit_every']) == 0) for i in range(1, 41)]
+    assert sum(p['audit'] for p in plans) == 40 // rules['pair_audit_every']
+    assert plans[0]['response'] is None and plans[rules['pair_audit_every']-1]['response'] is not None
+    assert plans[0]['packet'] == 'PROD_pop_cut_0001_PACKET'
