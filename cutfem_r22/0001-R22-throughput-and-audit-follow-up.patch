+from fractions import Fraction
+import pytest
+from stage_cutfem_full_interface.exact_numbers import exact, exact_row, ONE, BACKEND
+from stage_cutfem_full_interface.full_trace import _subtract
+from stage_cutfem_multiconstraint.pivot_coordinates import geometric_residuals_max_pivot, direct_sum_with_pivots
+
+
+def test_backend_serializes_like_fraction():
+    for value in (Fraction(-3, 4), Fraction(6, 3), Fraction(0), Fraction(7, 1)):
+        assert str(exact(value)) == str(value)
+    assert exact('5/10') == Fraction(1, 2) and ONE == 1
+
+
+def test_subtract_matches_fraction_reference_for_both_backends():
+    row = exact_row({0: Fraction(1, 2), 3: Fraction(-2, 7)})
+    basis = exact_row({0: Fraction(1, 4), 5: Fraction(3, 1)})
+    _subtract(row, basis, exact(2))
+    assert {k: Fraction(str(v)) for k, v in row.items()} == {3: Fraction(-2, 7), 5: Fraction(-6)}
+    fraction_row = {0: Fraction(1, 2), 3: Fraction(-2, 7)}
+    _subtract(fraction_row, {0: Fraction(1, 4), 5: Fraction(3)}, Fraction(2))
+    assert fraction_row == {3: Fraction(-2, 7), 5: Fraction(-6)}
+
+
+def test_pivot_elimination_is_backend_independent():
+    rows = [exact_row(r) for r in [{0: 1, 1: 2}, {0: 2, 1: 4}, {1: 1, 2: 3}, {2: 5}]]
+    selected, basis, combinations, pivots = geometric_residuals_max_pivot(rows)
+    assert selected == [0, 2, 3] and len(pivots) == 3
+    q, null, pivots, free = direct_sum_with_pivots(basis, pivots, 4)
+    assert free == [3] and all(str(v).count('/') <= 1 for row in q for v in row.values())
+    assert BACKEND in ('gmpy2.mpq', 'fractions.Fraction')
