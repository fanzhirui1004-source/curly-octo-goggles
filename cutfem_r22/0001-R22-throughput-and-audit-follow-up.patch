+import json
+from pathlib import Path
+import numpy as np
+from stage_cutfem_multiconstraint.polynomials import cosine_axis, _cosine_axis
+from stage_cutfem_gp.strain_coordinates import coefficients, _coefficients
+from stage_cutfem_multiconstraint.quadrature import r22_policy
+
+
+def test_cosine_axis_cache_is_bitwise_identical_and_isolated():
+    a, ra = cosine_axis(0.25, 0.28125, 8)
+    b, rb = _cosine_axis.__wrapped__(0.25, 0.28125, 8)
+    assert np.array_equal(a, b) and ra == rb
+    a[0] = 123.0
+    c, _ = cosine_axis(0.25, 0.28125, 8)
+    assert c[0] == b[0]
+
+
+def test_coefficients_cache_returns_same_values():
+    length = np.array([1/32, 1/32, 1/32])
+    first = coefficients(length)
+    second = coefficients(length.copy())
+    assert first is second and np.array_equal(first, _coefficients.__wrapped__((1/32, 1/32, 1/32)))
+
+
+def test_r22_integration_policy_registered():
+    policy, digest = r22_policy()
+    assert policy['enclosure_confirmation'] == 'disabled'
+    assert policy['candidate_order_search'] == 'descending_from_8' and policy['candidate_orders'][0] == 8
+    protocol = json.loads((Path(r22_policy.__code__.co_filename).with_name('PROTOCOL.json')).read_text())
+    assert all(order in protocol['integration']['orders'] for order in policy['candidate_orders'])
