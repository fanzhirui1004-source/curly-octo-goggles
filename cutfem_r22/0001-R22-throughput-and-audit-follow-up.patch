diff --git a/stage_cutfem_runtime/retire_sample.py b/stage_cutfem_runtime/retire_sample.py
new file mode 100644
index 0000000..f58dbd0
--- /dev/null
+++ b/stage_cutfem_runtime/retire_sample.py
@@ -0,0 +1,116 @@
+"""Losslessly archive reconstructible arrays of completed sample runs, with receipts.
+
+Selected files are gzip-archived through evidence_archive.archive_group: full
+decompression is verified against the sealed FILES.json digest before the
+original view is retired, and every group can be restored with the existing
+``evidence_archive restore`` command. Manifests and small records are untouched.
+"""
+import argparse
+import fnmatch
+import json
+import os
+import time
+from pathlib import Path
+from .config import ROOT
+from .resources import require_target
+from .provenance import write_json, sha256
+from .evidence_archive import archive_group
+
+DEFAULT_PATTERNS = ['body/element_K.npy', 'body/canonical_K.npy', 'body/canonical_G.npy', 'body/G_data.npy',
+                    'body/G_indices.npy', 'body/K_data.npy', 'body/K_indices.npy', 'body/V_data.npy',
+                    'body/V_indices.npy', 'ghost/element_K.npy', 'ghost/G_data.npy', 'ghost/G_indices.npy',
+                    'ghost/K_data.npy', 'ghost/K_indices.npy', 'global_body/*.npy']
+
+
+def aliases(digest, path):
+    """Every sealed alias of one inode: other run manifests and the sha256 object store."""
+    stat = path.stat()
+    inode = (stat.st_dev, stat.st_ino)
+    found = {path.resolve()}
+    candidate = ROOT/'objects/sha256'/digest[:2]/digest[2:]
+    if candidate.is_file():
+        found.add(candidate.resolve())
+    for manifest in (ROOT/'artifacts').glob('*/FILES.json'):
+        try:
+            entries = json.loads(manifest.read_text())
+        except ValueError:
+            continue
+        for relative, other in entries.items():
+            if other == digest:
+                alias = manifest.parent/relative
+                if alias.is_file():
+                    found.add(alias.resolve())
+    return [alias for alias in sorted(found) if (alias.stat().st_dev, alias.stat().st_ino) == inode]
+
+
+def select(run, patterns, minimum_bytes):
+    files = json.loads((run/'FILES.json').read_text())
+    for relative, digest in sorted(files.items()):
+        if not any(fnmatch.fnmatch(relative, pattern) for pattern in patterns):
+            continue
+        path = run/relative
+        if not path.is_file() or path.is_symlink():
+            continue
+        stat = path.stat()
+        if stat.st_size < minimum_bytes:
+            continue
+        yield relative, digest, path, stat
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--runs', nargs='+', required=True, help='Run ids under artifacts whose arrays are retired')
+    parser.add_argument('--patterns', nargs='*', default=DEFAULT_PATTERNS)
+    parser.add_argument('--minimum-mib', type=float, default=64)
+    parser.add_argument('--require-downstream-completed', nargs='*', default=[],
+                        help='Run ids that must be COMPLETED before anything is retired (e.g. the packet run)')
+    args = parser.parse_args()
+    require_target()
+    out = Path(os.environ['CUTFEM_STAGE_OUTPUT'])
+    start = time.perf_counter()
+    for run_id in args.require_downstream_completed:
+        terminal = ROOT/'artifacts'/run_id/'TERMINAL.json'
+        if not terminal.is_file() or json.loads(terminal.read_text())['status'] != 'COMPLETED':
+            raise ValueError('RETIRE_REQUIRES_COMPLETED_DOWNSTREAM:'+run_id)
+    records, skipped, done = [], [], set()
+    receipt = out/'ARCHIVES.jsonl'
+    for run_id in args.runs:
+        run = ROOT/'artifacts'/run_id
+        if not (run/'TERMINAL.json').is_file() or not (run/'FILES.json').is_file():
+            skipped.append(dict(run=run_id, reason='RUN_NOT_SEALED'))
+            continue
+        terminal = json.loads((run/'TERMINAL.json').read_text())
+        if terminal['status'] != 'COMPLETED':
+            skipped.append(dict(run=run_id, reason='RUN_NOT_COMPLETED'))
+            continue
+        for relative, digest, path, stat in select(run, args.patterns, args.minimum_mib*2**20):
+            if stat.st_mode & 0o222:
+                skipped.append(dict(run=run_id, file=relative, reason='NOT_SEALED_READ_ONLY'))
+                continue
+            group = [path] if stat.st_nlink == 1 else aliases(digest, path)
+            if len(group) != stat.st_nlink:
+                skipped.append(dict(run=run_id, file=relative, reason='UNRESOLVED_HARDLINK_ALIASES', links=stat.st_nlink, resolved=len(group)))
+                continue
+            if any(str(alias) in done for alias in group):
+                continue
+            done.update(str(alias) for alias in group)
+            record = archive_group(group, digest, ROOT/'objects/gzip', receipt, require_physical_saving=True)
+            records.append(dict(run=run_id, file=relative, aliases=len(group), original_bytes=record['original_bytes'],
+                                archive_bytes=record['archive_bytes'], released=record['net_allocated_bytes_released'],
+                                retired=record['source_retired']))
+            print(json.dumps(records[-1]), flush=True)
+    released = sum(r['released'] for r in records)
+    result = dict(status='SAMPLE_ARRAYS_LOSSLESSLY_ARCHIVED', runs=args.runs, patterns=args.patterns,
+                  minimum_bytes=int(args.minimum_mib*2**20), groups=len(records), files=records, skipped=skipped,
+                  net_allocated_bytes_released=released, receipt=str(receipt),
+                  restore_command='python -m stage_cutfem_runtime.evidence_archive restore ARCHIVES.jsonl ORIGINAL_SHA256',
+                  seconds=time.perf_counter()-start, original_manifests_unchanged=True, neural_training_authorized=False)
+    write_json(out/'RESULT.json', result)
+    (out/'REPORT.md').write_text('# 样本中间数组无损归档\n\n只归档可从网格和源码重建的大数组，逐文件解压校验封存哈希后才退役原文件；'
+        'FILES.json 与所有小记录不变，恢复命令见 RESULT.json。\n\n'
+        f"归档 {len(records)} 个文件，净释放 {released/2**30:.2f} GiB，跳过 {len(skipped)} 项。\n")
+    print(json.dumps(dict(status=result['status'], groups=len(records), released_gib=round(released/2**30, 3), skipped=len(skipped))), flush=True)
+
+
+if __name__ == '__main__':
+    main()
