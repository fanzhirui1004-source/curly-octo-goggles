index 0000000..d3479ff
--- /dev/null
+++ b/stage_cutfem_full_interface/exact_numbers.py
@@ -0,0 +1,29 @@
+"""Exact rational scalars for trace compilation: gmpy2.mpq when present, else Fraction.
+
+Both backends produce identical exact values and identical ``str`` forms
+(``"-3/4"``, ``"2"``), so serialized coordinate records and their digests do
+not depend on the backend. Only speed differs.
+"""
+from fractions import Fraction
+
+try:
+    from gmpy2 import mpq as _mpq
+    BACKEND = 'gmpy2.mpq'
+except ImportError:  # pragma: no cover - exercised only without the runtime
+    _mpq = None
+    BACKEND = 'fractions.Fraction'
+
+
+def exact(value):
+    """Convert an int, Fraction, str or exact scalar to the active exact type."""
+    if _mpq is not None:
+        return _mpq(value)
+    return Fraction(value)
+
+
+ONE = exact(1)
+
+
+def exact_row(row):
+    """Copy a sparse row (column -> scalar) into the active exact type."""
+    return {int(column): exact(value) for column, value in row.items()}
