@@ -0,0 +1,235 @@
+"""Two-lane production pipeline: geometry of sample k+1 overlaps operator/packet of sample k.
+
+The geometry stage saturates all assembly workers with about 12 GiB PSS; the
+operator and packet stages are mostly single-core with up to 35 GiB PSS. Running
+them in separate lanes keeps the box busy without changing any numerical stage.
+Every stage still runs through the create-only runner with its own receipts.
+"""
+import argparse
+import json
+import os
+import subprocess
+import sys
+import threading
+import time
+from collections import deque
+from pathlib import Path
+
+from stage_cutfem_runtime.config import ROOT, TARGET, assembly_workers, numeric_threads
+from stage_cutfem_runtime.resources import read_cgroup, require_target
+from stage_cutfem_runtime.provenance import sha256
+
+GIB = 1 << 30
+POLICY = Path(__file__).with_name('PRODUCTION_POLICY_R22.json')
+
+
+def policy():
+    return json.loads(POLICY.read_text())
+
+
+def run_dir(run_id):
+    return ROOT/'artifacts'/run_id
+
+
+def completed(run_id):
+    terminal = run_dir(run_id)/'TERMINAL.json'
+    return terminal.is_file() and json.loads(terminal.read_text())['status'] == 'COMPLETED'
+
+
+def stage_status(run_id):
+    result = run_dir(run_id)/'RESULT.json'
+    return json.loads(result.read_text()).get('status') if result.is_file() else None
+
+
+class Journal:
+    def __init__(self, path):
+        self.path = Path(path)
+        self.lock = threading.Lock()
+
+    def write(self, **record):
+        with self.lock, self.path.open('a') as f:
+            f.write(json.dumps(dict(record, time=time.time()))+'\n')
+            f.flush()
+            os.fsync(f.fileno())
+
+
+class Lane:
+    """Serializes runner invocations; admission waits for a memory budget."""
+    def __init__(self, name, pss_gib, journal, budget_gib, admission_lock, dry_run=False):
+        self.name = name
+        self.pss_gib = pss_gib
+        self.journal = journal
+        self.budget_gib = budget_gib
+        self.admission = admission_lock
+        self.dry_run = dry_run
+
+    def wait_for_memory(self, forecast_gib, others):
+        """Admit when the cgroup usage plus the running lanes' budgets fit."""
+        while True:
+            with self.admission:
+                current = read_cgroup()['memory_current']/GIB
+                reserved = sum(o.pss_gib for o in others if o.active)
+                if current + reserved + forecast_gib <= self.budget_gib:
+                    self.active = True
+                    return current
+            time.sleep(5)
+
+    active = False
+
+    def run(self, run_id, stage, command, runtimes, workers, solver_threads, pss_gib, wall, others, source):
+        if completed(run_id):
+            self.journal.write(event='SKIP_COMPLETED', lane=self.name, run=run_id)
+            return 'COMPLETED'
+        if run_dir(run_id).exists():
+            raise RuntimeError('RUN_EXISTS_BUT_NOT_COMPLETED:'+run_id)
+        waited_from = time.time()
+        current = self.wait_for_memory(pss_gib, others)
+        argv = [sys.executable, '-m', 'stage_cutfem_runtime.runner', '--run-id', run_id, '--stage', stage,
+                '--threads', '1', '--solver-threads', str(solver_threads), '--workers', str(workers),
+                '--pss-gib', str(pss_gib), '--disk-headroom-gib', '8']
+        for name in runtimes:
+            argv += ['--runtime', name]
+        argv += ['--', sys.executable, '-m', *command]
+        self.journal.write(event='START', lane=self.name, run=run_id, stage=stage, command=command,
+                           cgroup_gib_at_admission=round(current, 2), waited_seconds=round(time.time()-waited_from, 1))
+        start = time.time()
+        if self.dry_run:
+            self.journal.write(event='DRY_RUN', lane=self.name, run=run_id, argv=argv)
+            self.active = False
+            return 'DRY_RUN'
+        try:
+            process = subprocess.run(argv, cwd=source, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+        finally:
+            self.active = False
+        status = 'COMPLETED' if completed(run_id) else 'FAILED'
+        self.journal.write(event='END', lane=self.name, run=run_id, returncode=process.returncode, status=status,
+                           result_status=stage_status(run_id), wall_seconds=round(time.time()-start, 1),
+                           runner_tail=process.stdout[-600:])
+        return status
+
+
+def plan_case(prefix, case_id, audit):
+    ident = case_id.replace('-', '_')
+    return dict(case_id=case_id, audit=audit,
+                geometry=f'{prefix}_{ident}_GEOMETRY', operator=f'{prefix}_{ident}_OPERATOR',
+                response=f'{prefix}_{ident}_RESPONSE' if audit else None, packet=f'{prefix}_{ident}_PACKET')
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--prefix', required=True, help='Run-id prefix; every stage gets its own sealed run')
+    parser.add_argument('--panel-run', required=True, help='Registered panel run directory (trial register stage)')
+    parser.add_argument('--cases', nargs='+', required=True, help='case_id values from the registered panel')
+    parser.add_argument('--pair-audit-every', type=int, default=None,
+                        help='Run response+pair audit on every Nth case (1-based); default from PRODUCTION_POLICY_R22.json')
+    parser.add_argument('--lanes', type=int, choices=[1, 2], default=None)
+    parser.add_argument('--memory-budget-gib', type=float, default=None)
+    parser.add_argument('--matrix-format', choices=['full', 'packed-upper'], default='packed-upper')
+    parser.add_argument('--dry-run', action='store_true')
+    args = parser.parse_args()
+    require_target()
+    rules = policy()
+    every = rules['pair_audit_every'] if args.pair_audit_every is None else args.pair_audit_every
+    lanes = rules['lanes'] if args.lanes is None else args.lanes
+    budget = rules['memory_budget_gib'] if args.memory_budget_gib is None else args.memory_budget_gib
+    if not 1 <= every or budget > rules['container_guard_gib']:
+        raise ValueError('PIPELINE_POLICY_ARGUMENTS')
+    source = Path.cwd()
+    journal_dir = ROOT/'coordination'
+    journal_dir.mkdir(exist_ok=True)
+    journal = Journal(journal_dir/f'{args.prefix}_PIPELINE.jsonl')
+    plans = [plan_case(args.prefix, case, (index % every) == 0) for index, case in enumerate(args.cases, start=1)]
+    journal.write(event='PIPELINE_REGISTRATION', prefix=args.prefix, panel_run=args.panel_run, cases=args.cases,
+                  lanes=lanes, pair_audit_every=every, memory_budget_gib=budget, policy_sha256=sha256(POLICY),
+                  source=str(source), matrix_format=args.matrix_format, dry_run=args.dry_run,
+                  bulk_data_production_authorized=rules['bulk_data_production_authorized'])
+    admission = threading.Lock()
+    geometry_lane = Lane('geometry', rules['stage_pss_gib']['geometry'], journal, budget, admission, args.dry_run)
+    operator_lane = Lane('operator', rules['stage_pss_gib']['operator'], journal, budget, admission, args.dry_run)
+    lane_list = [geometry_lane, operator_lane]
+    runtimes = rules['runtimes']
+    workers = assembly_workers()
+    threads = numeric_threads()
+    ready = deque()
+    ready_event = threading.Event()
+    failures = []
+    geometry_done = threading.Event()
+
+    def geometry_worker():
+        for plan in plans:
+            status = geometry_lane.run(plan['geometry'], 'geometry',
+                ['stage_cutfem_multiconstraint.trial', 'geometry', '--panel-run', args.panel_run, '--case-id', plan['case_id']],
+                runtimes, workers, threads, rules['stage_pss_gib']['geometry'], None, [operator_lane], source)
+            if status in ('COMPLETED', 'DRY_RUN') and (args.dry_run or stage_status(plan['geometry']) == 'GEOMETRY_INTEGRATION_LOCAL_TRACE_QUALIFIED_COMPLETE_CHAIN_PENDING'):
+                ready.append(plan)
+            else:
+                failures.append(dict(case=plan['case_id'], stage='geometry', status=status,
+                                     result_status=None if args.dry_run else stage_status(plan['geometry'])))
+                journal.write(event='CASE_STOPPED_AT_GEOMETRY', case=plan['case_id'], status=status)
+            ready_event.set()
+            if lanes == 1:
+                # Single lane: drain before the next geometry.
+                while ready:
+                    operator_chain(ready.popleft())
+        geometry_done.set()
+        ready_event.set()
+
+    def operator_chain(plan):
+        g, o = ROOT/'artifacts'/plan['geometry'], ROOT/'artifacts'/plan['operator']
+        status = operator_lane.run(plan['operator'], 'assembly',
+            ['stage_cutfem_multiconstraint.trial', 'operator', '--geometry-run', str(g)],
+            runtimes, workers, threads, rules['stage_pss_gib']['operator'], None, [geometry_lane], source)
+        if status not in ('COMPLETED', 'DRY_RUN'):
+            failures.append(dict(case=plan['case_id'], stage='operator', status=status)); return
+        packet_command = ['stage_cutfem_multiconstraint.trial', 'packet', '--geometry-run', str(g),
+                          '--operator-run', str(o), '--matrix-format', args.matrix_format]
+        if plan['audit']:
+            r = ROOT/'artifacts'/plan['response']
+            status = operator_lane.run(plan['response'], 'solver',
+                ['stage_cutfem_multiconstraint.trial', 'response', '--geometry-run', str(g), '--operator-run', str(o)],
+                runtimes, workers, threads, rules['stage_pss_gib']['response'], None, [geometry_lane], source)
+            if status not in ('COMPLETED', 'DRY_RUN'):
+                failures.append(dict(case=plan['case_id'], stage='response', status=status)); return
+            packet_command += ['--response-run', str(r)]
+        status = operator_lane.run(plan['packet'], 'solver', packet_command, runtimes, workers, threads,
+                                   rules['stage_pss_gib']['packet'], None, [geometry_lane], source)
+        if status not in ('COMPLETED', 'DRY_RUN'):
+            failures.append(dict(case=plan['case_id'], stage='packet', status=status)); return
+        if rules.get('retire_after_packet'):
+            # Reconstructible arrays of this sample are archived losslessly with
+            # receipts once the packet is sealed; RESULT/manifests stay online.
+            retired = [plan['geometry'], plan['operator']] + ([plan['response']] if plan['audit'] else [])
+            status = operator_lane.run(plan['packet']+'_RETIRE', 'analysis',
+                ['stage_cutfem_runtime.retire_sample', '--runs', *retired, '--require-downstream-completed', plan['packet']],
+                runtimes, 1, 1, rules['stage_pss_gib']['retire'], None, [geometry_lane], source)
+            if status not in ('COMPLETED', 'DRY_RUN'):
+                failures.append(dict(case=plan['case_id'], stage='retire', status=status))
+
+    def operator_worker():
+        while True:
+            ready_event.wait(timeout=5)
+            ready_event.clear()
+            while ready:
+                operator_chain(ready.popleft())
+            if geometry_done.is_set() and not ready:
+                return
+
+    geometry_thread = threading.Thread(target=geometry_worker, name='geometry-lane', daemon=True)
+    geometry_thread.start()
+    if lanes == 2:
+        operator_thread = threading.Thread(target=operator_worker, name='operator-lane', daemon=True)
+        operator_thread.start()
+        geometry_thread.join()
+        operator_thread.join()
+    else:
+        geometry_thread.join()
+    summary = dict(event='PIPELINE_END', prefix=args.prefix, cases=len(plans), failures=failures,
+                   audited=[p['case_id'] for p in plans if p['audit']])
+    journal.write(**summary)
+    print(json.dumps(summary), flush=True)
+    if failures:
+        raise SystemExit(1)
+
+
+if __name__ == '__main__':
+    main()
