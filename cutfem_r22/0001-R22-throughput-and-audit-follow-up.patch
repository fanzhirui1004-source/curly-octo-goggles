+    def map_unordered(self, function, jobs, initializer=None, initargs=()):
+        """Yield (job_index, result) as workers finish; no head-of-line blocking.
+
+        Independent per-job results are reassembled by the caller with the
+        returned index, so scheduling order never changes any output.
+        """
+        from concurrent.futures import wait, FIRST_COMPLETED
+        if self.workers == 1:
+            for index, result in enumerate(self.map(function, jobs, initializer, initargs)):
+                yield index, result
+            return
+        if self.pool is None:
+            self.pool=ProcessPoolExecutor(max_workers=self.workers,
+                mp_context=multiprocessing.get_context('spawn'),initializer=initialize_worker)
+        self.generation+=1;pending={}
+        limit=max(self.limit,4*self.workers)
+        try:
+            for key,job in enumerate(jobs):
+                future=self.pool.submit(_dispatch,(self.generation,initializer,initargs,function,job))
+                pending[future]=key
+                if len(pending)>=limit:
+                    done,_=wait(list(pending),return_when=FIRST_COMPLETED)
+                    for finished in done:
+                        yield pending.pop(finished),finished.result()
+            while pending:
+                done,_=wait(list(pending),return_when=FIRST_COMPLETED)
+                for finished in done:
+                    yield pending.pop(finished),finished.result()
+        finally:
+            for future in pending:future.cancel()
+
+
