+def classify_packet(run_id):
+    """Scientific outcome of a sealed packet run, independent of the process exit code."""
+    result = run_dir(run_id)/'RESULT.json'
+    failure = run_dir(run_id)/'FAILURE.json'
+    if not result.is_file():
+        return 'STAGE_FAILED', json.loads(failure.read_text()).get('error') if failure.is_file() else None
+    record = json.loads(result.read_text())
+    pair = (record.get('pair') or {}).get('status')
+    status = record.get('status')
+    if status == 'T04_COMPLETE_OPERATOR_PACKET_AND_APPLICABLE_PAIR_PASS' and pair == 'SAVED_N32_PACKET_PAIR_REPLAY_PASS':
+        return 'PAIR_AUDIT_PASS', pair
