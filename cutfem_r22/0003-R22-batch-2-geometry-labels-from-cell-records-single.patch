index 0000000..2f8e01b
--- /dev/null
+++ b/stage_cutfem_preproduction/registered_fields.py
@@ -0,0 +1,26 @@
+"""Registered analytic boundary fields shared by the CutFEM probes and the fitted reference.
+
+The first three are the R18 selection fields (frequency f on x and y, 1 on z).
+The fourth is the R22 independent verification field: it mixes frequencies
+that were all individually tested (2, 3, 2) and took no part in choosing gamma.
+"""
+import numpy as np
+
+FIELDS = [dict(name='R18_f1', frequencies=(1, 1, 1), role='selection'),
+          dict(name='R18_f2', frequencies=(2, 2, 1), role='selection'),
+          dict(name='R18_f3', frequencies=(3, 3, 1), role='selection'),
+          dict(name='R22_independent_232', frequencies=(2, 3, 2), role='independent_verification')]
+SELECTION_COUNT = 3
+
+
+def analytic_field(spec, xyz, component):
+    fx, fy, fz = spec['frequencies']
+    return (np.sin(fx*np.pi*xyz[:, 0]+.27*component)*np.cos(fy*np.pi*xyz[:, 1]+.31)
+            *np.sin(fz*np.pi*xyz[:, 2]+.57))
+
+
+def analytic_fields(points, specs=None):
+    """Node-major xyz ordering, one column per registered field."""
+    xyz = np.repeat(np.asarray(points), 3, axis=0)
+    component = np.arange(len(xyz)) % 3
+    return np.stack([analytic_field(spec, xyz, component) for spec in (specs or FIELDS)], axis=1)
