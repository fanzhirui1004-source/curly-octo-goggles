+++ b/scripts/pred777h_full_cube_v1/run_cgal_mesh_qualification.py
@@ -56,11 +56,13 @@ def _git_head() -> str:
 
 
 def _qualification_status(audit: dict[str, object], *, fixed_port_pass: bool) -> dict[str, str]:
-    """Fail closed when the extracted boundary is not a two-manifold.
+    """Apply the frozen topology gate, then the independent fixed-port gate.
 
-    A conforming tetrahedral complex can enumerate every exterior face exactly
-    once while its exterior surface still has an edge shared by more than two
-    facets.  That is a geometry/meshing failure, not a fixed-port success.
+    Hard-zero fields (inverted / zero-volume / duplicate / circumcenter) mean
+    the tetrahedral complex itself is invalid.  A boundary pinch (an exterior
+    edge shared by four exterior facets) is bounded rather than hard-zero: it
+    leaves the complex conforming and is certified or rejected by the
+    fixed-port kinematic and FE mechanics gates that follow.
     """
 
     topology = audit["topology"]
