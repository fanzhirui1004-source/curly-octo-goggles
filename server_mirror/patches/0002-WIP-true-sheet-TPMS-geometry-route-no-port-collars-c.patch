+def resnap_boundary_to_planes(V: np.ndarray, F: np.ndarray, planes, max_dist: float) -> tuple[np.ndarray, int]:
+    """Every boundary vertex of the open sheet must lie on a clip plane; vertices that drifted (remeshing) are moved back onto
+    the nearest plane(s) within max_dist, solving for all selected planes simultaneously (planes need not be orthogonal)."""
+    V = V.copy(); bnd = sorted({v for e in _directed_boundary(F) for v in e}); moved = 0
+    for v in bnd:
+        close = sorted([(abs(V[v] @ n - d), n, d) for _, n, d in planes if abs(V[v] @ n - d) <= max_dist], key=lambda t: t[0])[:3]
+        if not close or close[0][0] <= 1e-12 and len(close) == 1:
+            continue
