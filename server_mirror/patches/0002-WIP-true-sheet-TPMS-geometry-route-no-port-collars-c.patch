+def split_line_t_junctions(V: np.ndarray, F: np.ndarray, labels: list[str], planes, tol: float = 1e-9):
+    """Vertices lying on >= 2 clip planes (box edges, cut lines) that fall strictly inside an edge of a triangle running
+    along the same line split that edge (removes T-junctions between caps built independently)."""
+    onp = np.zeros((len(V), len(planes)), bool)
