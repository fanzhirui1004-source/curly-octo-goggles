+def carrier_active_set(geometry, layout, active_ports, *, samples: int = 48, interior_margin: float = 0.003) -> tuple[np.ndarray, list, dict]:
+    """Mesh-independent active carrier nodes: vertices of every carrier trace triangle that intersects the material band
+    on its face (band = |phi| <= tau, retained side of the cut).  Returns (shell coords, per-face triangle arrays restricted
+    to intersecting triangles, {face: {triangle index: material support point well inside the triangle and the band}})."""
+    shell_coords, _, per_face = carrier_shell(layout, tuple(a for a in active_ports if a != "cut_0"))
+    planes = clip_planes(geometry)
+    bary = np.asarray([(i / samples, j / samples, 1 - (i + j) / samples) for i in range(samples + 1) for j in range(samples + 1 - i)])
+    kept = []; support_points: dict[str, dict[int, np.ndarray]] = {}
