+def snap_near_plane(V: np.ndarray, n: np.ndarray, d: float, eps: float) -> np.ndarray:
+    """Move vertices closer than eps to the plane exactly onto it (avoids sliver triangles after clipping)."""
+    V = V.copy(); s = V @ n - d; m = np.abs(s) < eps
