+        for k in range(3):
+            e = np.zeros(3); e[k] = fd
+            g[:, k] = (sheet_level(geometry, V + e) - sheet_level(geometry, V - e)) / (2 * fd)
+        g2 = np.einsum("ij,ij->i", g, g); step = (f / np.maximum(g2, 1e-300))[:, None] * g
+        V -= step
