+def flip_flat_triangles(V: np.ndarray, F: np.ndarray, planes, tol: float = 1e-9, max_passes: int = 4) -> tuple[np.ndarray, int]:
+    """A sheet triangle with all three vertices on one clip plane (all three on the boundary polyline) is removed by
+    flipping one of its interior edges with the neighbouring triangle; no vertex is added or removed."""
+    F = np.asarray(F, dtype=np.int64).copy(); flipped = 0
