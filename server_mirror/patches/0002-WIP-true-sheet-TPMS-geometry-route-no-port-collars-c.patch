+    Insert the line point (projection of the edge midpoint onto both planes) and split the edge, so the boundary chain
+    of each plane is closed through the corner."""
+    V = np.asarray(V, dtype=np.float64).copy(); F = np.asarray(F, dtype=np.int64)
