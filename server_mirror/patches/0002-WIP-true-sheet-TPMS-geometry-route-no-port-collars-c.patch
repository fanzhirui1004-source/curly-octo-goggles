+def collapse_short_boundary_edges(V: np.ndarray, F: np.ndarray, planes, min_len: float, max_passes: int = 10) -> tuple[np.ndarray, np.ndarray, int]:
+    """Collapse boundary (on-plane) edges shorter than min_len by merging the removable endpoint into the other.
+    Vertices lying on two or more clip planes (box edges/corners) are never removed."""
+    V = np.asarray(V, dtype=np.float64).copy(); F = np.asarray(F, dtype=np.int64).copy(); total = 0
+    for _ in range(max_passes):
+        onp = np.zeros(len(V), dtype=int)
