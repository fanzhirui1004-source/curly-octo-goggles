+            onp += (np.abs(V @ n - d) <= 1e-9)
+        edges = _directed_boundary(F)
+        short = [(a, b) for a, b in edges if np.linalg.norm(V[a] - V[b]) < min_len and onp[a] > 0 and onp[b] > 0]
+        if not short:
+            break
