+def handle_flat_triangles(geometry, V: np.ndarray, F: np.ndarray, planes, tol: float = 1e-9) -> tuple[np.ndarray, np.ndarray, dict]:
+    """Sheet triangles lying in a clip plane: if the triangle has at least two boundary edges (a boundary 'ear' of three
+    consecutive boundary vertices) it is dropped (the cap covers that area and the chain shortcut is exact); otherwise it
+    is lifted: replaced by a fan around a new vertex pushed inward and projected onto the sheet."""
