+    inside_full=sss.sheet_level(geom,Pnts)<0.0; vol_full=float(inside_full.mean())
+    try:
+        L=open(Path(md)/'mesh.mesh').read().split('\n'); i=L.index('Vertices'); nv=int(L[i+1])
