+def _flatten_tangent_patches(geometry, V: np.ndarray, F: np.ndarray, planes, tol: float, max_rounds: int = 8) -> tuple[np.ndarray, int]:
+    """Sheet triangles lying within `tol` of a clip plane with the material between them and the plane (the band level
+    rises away from the plane) bound a sliver thinner than the mesh can carry.  Their vertices are snapped onto the
+    plane, so the flat-triangle drop removes them and the cap closes the solid there.  Snapping only some vertices of
+    such a patch (the plain near-plane snap) pinches the sheet onto the cap along an interior edge, an edge with four
+    triangles (census 2026-09-04, sheet tangent to the cut plane beside a face edge).  Iterated: a flattened patch can
+    expose the next ring.  Returns (vertices, number of triangles flattened)."""
+    V = V.copy(); total = 0
+    for _ in range(max_rounds):
+        moved = False
+        for _, n, d in planes:
+            s = V @ n - d; sF = np.abs(s[F])
+            cand = (sF <= tol).all(axis=1) & ~(sF <= 1e-9).all(axis=1)
+            if not cand.any():
+                continue
+            cen = V[F[cand]].mean(axis=1); g = np.zeros_like(cen)
+            for k in range(3):
+                e = np.zeros(3); e[k] = 1e-6
+                g[:, k] = (sheet_level(geometry, cen + e) - sheet_level(geometry, cen - e)) / 2e-6
+            patch = F[cand][(g @ n) < 0.0]          # void lies away from the plane: the sliver in between is material
+            if not len(patch):
+                continue
+            allow = np.zeros(len(V), bool); allow[np.unique(patch)] = True
+            V2 = snap_near_plane_constrained(V, n, d, tol * (1.0 + 1e-9), planes, allow=allow, max_move=2.0)
+            flat = (np.abs(V2[patch] @ n - d) <= 1e-9).all(axis=1)
+            if flat.any():
+                V = V2; total += int(flat.sum()); moved = True
+        if not moved:
+            break
+    return V, total
+
+
