diff --git a/src/pred777h_full_cube_single_cell_mesh_graph_fixed_port_schur_v1/carrier_triangulation.py b/src/pred777h_full_cube_single_cell_mesh_graph_fixed_port_schur_v1/carrier_triangulation.py
