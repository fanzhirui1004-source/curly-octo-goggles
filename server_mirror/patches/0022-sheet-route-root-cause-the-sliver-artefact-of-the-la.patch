+          f"machine time {tt.mean() * 1949 / 3600:.0f} core-batches, wall at 8 concurrent {tt.mean() * 1949 / 8 / 3600:.1f} h")
+    tet = col("mesh.tet_count"); dof = 3 * col("mesh.node_count")
